rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Lessons: authenticated read, admin-managed writes
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Quizzes: authenticated read, admin-managed writes
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Optional questions collection (if stored separately): authenticated read, admin-managed writes
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User progress: only the owner can read/write
    match /userProgress/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // User profiles: only the owner can read/write
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Default deny for any other paths
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}